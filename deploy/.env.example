# Copy to /opt/gym-tracker/.env on the EC2 instance
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest

RDS_HOST=gym-tracker-db.xxxxxx.us-east-1.rds.amazonaws.com
RDS_DATABASE=gym_tracker
RDS_USERNAME=gymadmin
RDS_PASSWORD=change-me

JWT_SECRET=replace-with-strong-random-min-32-chars
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com,http://your-public-ip
